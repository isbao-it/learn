# LLM Configuration (默认 DeepSeek)

# 配置大型语言模型(LLM)的相关参数，默认使用DeepSeek服务
LLM_API_KEY=  *** DeepSeek API的访问密钥（真实密钥已移至 .env.local，勿提交）
LLM_BASE_URL=https://api.deepseek.com/v1  # DeepSeek API的基础URL地址
LLM_MODEL=deepseek-chat  # 使用的DeepSeek模型名称

# Database

# 数据库相关配置
DATABASE_URL=sqlite+aiosqlite:///./data/baokuan.db  # SQLite数据库的连接URL，使用aiosqlite异步驱动
# 它的核心价值在于非阻塞。普通的 sqlite3 操作是同步的，会长时间占用CPU，在异步程序中会阻塞其他任务。
# aiosqlite 通过为每个数据库连接创建一个独立的线程，并将所有操作放入该线程的队列中顺序执行。这样，
# 主事件循环只需发起请求，就可以去处理其他任务，等待数据库操作完成后再获取结果
CHROMA_PERSIST_DIR=./chroma_data  # Chroma向量数据库的持久化存储目录

# Server

# 服务器配置
HOST=0.0.0.0  # 服务器监听地址，0.0.0.0表示监听所有可用的网络接口
PORT=8000  # 服务器监听的端口号
